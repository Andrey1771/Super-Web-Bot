# Образ сайта: собранный фронт + nginx, который проксирует API, бота и Keycloak.
# Один и тот же образ работает на стенде и в продакшене — режим задаёт NGINX_SITE (dev|prod),
# адреса и ключи приходят из переменных окружения при старте (см. nginx/docker-entrypoint.d).

# Первый этап: сборка фронтенда
FROM node:24-alpine AS frontend

WORKDIR /app
COPY ./tale-gameshop/package*.json ./
RUN npm ci
COPY ./tale-gameshop .
RUN npm run build

# Второй этап: nginx
FROM nginx:alpine

# openssl — временный самоподписанный сертификат, пока Let's Encrypt не выдал настоящий.
RUN apk add --no-cache openssl \
    && rm -f /etc/nginx/conf.d/default.conf \
    && : > /etc/nginx/trusted-proxies.conf

COPY nginx/nginx.conf /etc/nginx/nginx.conf
COPY nginx/security-headers.conf /etc/nginx/security-headers.conf
COPY nginx/locations.conf /etc/nginx/locations.conf
COPY nginx/templates/ /etc/nginx/site-templates/
COPY nginx/docker-entrypoint.d/ /docker-entrypoint.d/
COPY nginx/taleshop-pick-cert nginx/taleshop-reload /usr/local/bin/
# Сборка с Windows-машины приносит CRLF и снятый бит исполнения — чиним здесь, а не надеемся на git.
RUN sed -i 's/\r$//' /docker-entrypoint.d/*taleshop* /usr/local/bin/taleshop-* /etc/nginx/site-templates/* \
    && chmod +x /docker-entrypoint.d/*taleshop*.sh /usr/local/bin/taleshop-*

COPY --from=frontend /app/dist /usr/share/nginx/html

EXPOSE 80 443

CMD ["nginx", "-g", "daemon off;"]
