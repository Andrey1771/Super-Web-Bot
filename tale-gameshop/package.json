{
  "name": "tale-gameshop",
  "version": "0.1.0",
  "private": true,
  "dependencies": {
    "@fortawesome/fontawesome-svg-core": "^7.3.1",
    "@fortawesome/free-brands-svg-icons": "^7.3.1",
    "@fortawesome/free-solid-svg-icons": "^7.3.1",
    "@fortawesome/react-fontawesome": "^3.5.0",
    "@react-keycloak/web": "^3.4.0",
    "@reduxjs/toolkit": "^2.3.0",
    "@stripe/react-stripe-js": "^6.12.0",
    "@stripe/stripe-js": "^9.17.0",
    "axios": "^1.7.7",
    "dompurify": "^3.1.7",
    "eventemitter3": "^5.0.4",
    "express": "^5.2.1",
    "highcharts": "^13.1.1",
    "highcharts-react-official": "^3.2.1",
    "i18next": "^26.4.2",
    "js-cookie": "^3.0.5",
    "keycloak-js": "^26.0.6",
    "marked": "^18.0.14",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-i18next": "^17.0.15",
    "react-redux": "^9.1.2",
    "react-router-dom": "^7.18.4",
    "web-vitals": "^6.2.2"
  },
  "scripts": {
    "start": "webpack serve --open --config webpack.config.js --mode development",
    "start:dev": "webpack serve --open --config webpack.config.js --mode development",
    "start:prod": "node server.js",
    "build": "cross-env NODE_OPTIONS=--max_old_space_size=4096 webpack --mode production",
    "build:dev": "webpack --mode development",
    "dev": "webpack --config webpack.config.js --mode development",
    "cert:dev": "node -e \"require('fs').mkdirSync('certs',{recursive:true})\" && mkcert -install && mkcert -key-file certs/localhost-key.pem -cert-file certs/localhost.pem localhost 127.0.0.1 ::1",
    "lint": "eslint src",
    "test": "jest",
    "check:merge-markers": "node scripts/check-merge-markers.mjs",
    "prestart": "npm run check:merge-markers",
    "prestart:dev": "npm run check:merge-markers",
    "prebuild:dev": "npm run check:merge-markers",
    "lint:i18n": "eslint src --rule \"react-hooks/exhaustive-deps: off\"",
    "test:watch": "jest --watch"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "@babel/core": "^8.0.6",
    "@babel/eslint-parser": "^8.0.6",
    "@babel/plugin-proposal-decorators": "^8.0.2",
    "@babel/preset-env": "^8.0.6",
    "@babel/preset-react": "^8.0.1",
    "@babel/preset-typescript": "^8.0.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.19.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.20",
    "babel-jest": "^30.5.2",
    "babel-loader": "^10.1.1",
    "babel-plugin-transform-typescript-metadata": "^0.4.0",
    "copy-webpack-plugin": "^14.0.0",
    "cross-env": "^10.1.0",
    "css-loader": "^7.1.5",
    "eslint": "^10.11.0",
    "eslint-plugin-i18next": "^6.1.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "html-loader": "^5.1.0",
    "html-webpack-plugin": "^5.6.8",
    "inversify": "^8.2.3",
    "jest": "^30.5.2",
    "jest-environment-jsdom": "^30.5.2",
    "mini-css-extract-plugin": "^2.10.2",
    "postcss": "^8.4.47",
    "postcss-loader": "^8.2.1",
    "reflect-metadata": "0.2.2",
    "style-loader": "^4.0.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "webpack": "^5.111.1",
    "webpack-cli": "^7.2.3",
    "webpack-dev-server": "^6.0.0"
  },
  "type": "module"
}
