<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Local dev secrets live outside the repo: `dotnet user-secrets set "JwtSettings:SecretKey" "..."` -->
    <UserSecretsId>superbot-webapi-secrets</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Hangfire" Version="1.8.25" />
    <PackageReference Include="Hangfire.AspNetCore" Version="1.8.25" />
    <PackageReference Include="Hangfire.Mongo" Version="1.17.0" />
    <PackageReference Include="HtmlAgilityPack" Version="1.13.0" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.12" />
    <!-- Картинки: SkiaSharp (MIT). ImageSharp 4 требует платный ключ даже для сборки. -->
    <PackageReference Include="SkiaSharp" Version="4.153.1" />
    <!-- Нативная часть для Linux-образа: без fontconfig и прочих системных библиотек. -->
    <PackageReference Include="SkiaSharp.NativeAssets.Linux.NoDependencies" Version="4.153.1" />
    <PackageReference Include="Stripe.net" Version="52.4.2" />
    <PackageReference Include="Swashbuckle.AspNetCore" Version="10.2.3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\SuperBot.Application\SuperBot.Application.csproj" />
    <ProjectReference Include="..\SuperBot.Common.Auth\SuperBot.Common.Auth.csproj" />
    <ProjectReference Include="..\SuperBot.Core\SuperBot.Core.csproj" />
    <ProjectReference Include="..\SuperBot.Infrastructure\SuperBot.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Folder Include="wwwroot\" />
  </ItemGroup>

  <ItemGroup>
    <!-- HTML-шаблоны писем: правятся как обычный HTML, в рантайме читаются из сборки -->
    <EmbeddedResource Include="Newsletter\Templates\*.html" />
    <!-- Логотип для шапки писем: раздаётся самим бэкендом (см. EmailAssetsController),
         чтобы письмо не зависело от деплоя фронта. Едет вместе с DLL. -->
    <EmbeddedResource Include="Mail\Assets\*.png" />
    <!-- Стартовый каталог для импорта из Steam: список appid, на сервере доступен без репозитория. -->
    <EmbeddedResource Include="Services\SteamImport\starter-catalog.txt" LogicalName="SteamImport.starter-catalog.txt" />
  </ItemGroup>

</Project>
