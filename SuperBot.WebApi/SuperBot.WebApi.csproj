<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Local dev secrets live outside the repo: `dotnet user-secrets set "JwtSettings:SecretKey" "..."` -->
    <UserSecretsId>superbot-webapi-secrets</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Hangfire" Version="1.8.15" />
    <PackageReference Include="Hangfire.AspNetCore" Version="1.8.15" />
    <PackageReference Include="Hangfire.Mongo" Version="1.11.0" />
    <PackageReference Include="MediatR" Version="12.4.1" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="8.0.10" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="8.0.8" />
    <PackageReference Include="SixLabors.ImageSharp" Version="3.1.6" />
    <PackageReference Include="Stripe.net" Version="47.1.0" />
    <PackageReference Include="Swashbuckle.AspNetCore" Version="6.7.3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\SuperBot.Application\SuperBot.Application.csproj" />
    <ProjectReference Include="..\SuperBot.Common.Auth\SuperBot.Common.Auth.csproj" />
    <ProjectReference Include="..\SuperBot.Core\SuperBot.Core.csproj" />
    <ProjectReference Include="..\SuperBot.Infrastructure\SuperBot.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Folder Include="wwwroot\" />
  </ItemGroup>

  <ItemGroup>
    <!-- HTML-шаблоны писем: правятся как обычный HTML, в рантайме читаются из сборки -->
    <EmbeddedResource Include="Newsletter\Templates\*.html" />
    <!-- Логотип для шапки писем: раздаётся самим бэкендом (см. EmailAssetsController),
         чтобы письмо не зависело от деплоя фронта. Едет вместе с DLL. -->
    <EmbeddedResource Include="Mail\Assets\*.png" />
  </ItemGroup>

</Project>
