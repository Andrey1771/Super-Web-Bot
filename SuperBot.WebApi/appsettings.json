{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Diagnostics": {
    "LogHttpRequests": false
  },
  "AllowedHosts": "*",
  "BotConfiguration": {
    "BotToken": "__SET_VIA_ENV__",
    "BotWebhookUrl": "http://localhost/api/Telegram"
  },
  "ConnectionStrings": {
    "MongoDb": "mongodb://localhost:27017", //"mongodb://localhost:27017", // mongodb://localhost:27017/?replicaSet=rs0 - для релиза с репликой rs0
    "Name": "SteamShopDatabase"
  },
  "MainUrl": "http://localhost",
  "TelegramUsername": "andrey6eb",
  "AdminChatId": "795184375",
  "CommissionRate": 15,
  "JwtSettings": {
    "SecretKey": "__SET_VIA_ENV__",
    "Issuer": "http://localhost",
    "Audience": "http://localhost",
    "ExpiresInMinutes": 60
  },
  "Keycloak": {
    "Uri": "http://localhost:8088", // prod: задаётся через env Keycloak__Uri (публичный адрес Keycloak)
    "Realm": "TaleShop",
    "Audience": "account"
  },
  // Валюты магазина. BaseCurrency — валюта каталога: в ней хранится Game.Price.
  // SupportedCurrencies — что покупатель увидит в переключателе. Добавлять валюту сюда можно
  // только после того, как у игр заполнены цены в ней: иначе чекаут откажет в оплате корзины.
  "Storefront": {
    "BaseCurrency": "USD",
    "SupportedCurrencies": [],
    // Пересчёт по курсу — для валют, где цена не заведена руками. Ручная цена всегда важнее.
    // ManualRates: сколько единиц валюты даёт одна единица базовой. Пока правит человек;
    // автоматический импорт подключается через IFxRateService.Offer, гард уже там.
    // Rounding: NinetyNine | Ten | Hundred | None — округление всегда вверх.
    "Fx": {
      "MarkupPercent": 3,
      "MaxChangePercent": 10,
      "ManualRates": {},
      "Rounding": {},
      // Автоматический импорт раз в сутки. Url пуст — импорта нет, курсы правит человек
      // через api/admin/fx-rates. {base} подставляется базовой валютой каталога.
      // Пример бесплатного сервиса без ключа: https://open.er-api.com/v6/latest/{base}
      "Source": {
        "Url": "",
        "RatesProperty": "rates"
      }
    }
  },
  "Stripe": {
    "SecretKey": "__SET_VIA_ENV__",
    "PublishableKey": "__SET_VIA_ENV__",
    "WebhookSecret": "__SET_VIA_ENV__"
  },
  "FrontendConfiguration": {
    "Uri": "http://localhost" // prod: задаётся через env FrontendConfiguration__Uri (публичный адрес сайта)
  },
  "Support": {
    "AttachmentMaxMb": 10,
    "MaxAttachmentsPerMessage": 5,
    "SubjectMaxLength": 120,
    "DescriptionMaxLength": 2000,
    "MessageMaxLength": 2000,
    "ListPageSizeMax": 100,
    "AllowedContentTypes": [
      "image/png",
      "image/jpeg",
      "application/pdf"
    ],
    "TicketRateLimit": {
      "MaxTickets": 5,
      "WindowMinutes": 10
    },
    "Roles": {
      "Roles": [
        "admin",
        "support"
      ]
    }
  },
  "Recovery": {
    "WaitingPeriodHours": 72,
    "MaxRequestsPerIpPerHour": 3,
    "SmtpHost": "localhost", // в docker — mailhog (см. docker-compose env)
    "SmtpPort": 1025,
    "FromAddress": "no-reply@taleshop.local",
    "FromName": "Tale Shop",
    "PublicBaseUrl": "http://localhost"
  },
  "Payments": {
    // Сколько у гостя есть времени подтвердить почту по ссылке из письма, прежде чем
    // заказ автоматически вернётся. Бизнес-политика — меняется без пересборки.
    "DeliveryVerificationTtlHours": 48
  },
  "SupportChat": {
    "Provider": "ollama",
    "ProviderCooldownSeconds": 60,
    "MaxResponseTokens": 400,
    "DeepSeekBaseUrl": "https://api.deepseek.com/v1",
    "DeepSeekApiKey": "",
    "DeepSeekModel": "",
    "DailyBudgetUsd": 0,
    "InputPricePerMillionUsd": 0.14,
    "CachedInputPricePerMillionUsd": 0.0028,
    "OutputPricePerMillionUsd": 0.28,
    "OllamaBaseUrl": "http://localhost:11434",
    "OllamaModel": "qwen2.5:7b",
    "StreamingEnabled": true,
    "MessageMaxLength": 2000,
    "RateLimitPerMinute": 12,
    "HistoryLimit": 24,
    "HistoryTrimStepMessages": 8,
    "LlmTimeoutSeconds": 45,
    "Temperature": 0.3,
    "KnowledgeArticles": 2,
    "KnowledgeArticleMaxChars": 700,
    "InstantAnswersEnabled": true,
    "InstantAnswerMaxWords": 10,
    "InstantAnswerMaxChars": 160,
    "BusinessHoursEnabled": false,
    "BusinessHoursTimeZone": "UTC",
    "BusinessHoursStart": 10,
    "BusinessHoursEnd": 19,
    "BusinessDays": [ 1, 2, 3, 4, 5 ],
    "ExpectedWaitMinutes": 15,
    // Куда писать при передаче диалога человеку. Пусто — письмо уходит на адрес отправителя
    // из Recovery:FromAddress. Реальный ящик задаётся переменной SupportChat__SpecialistEmail:
    // прежняя заглушка support@taleshop.local молча съедала все уведомления.
    "SpecialistEmail": "",
    "NotifyTelegramOnEscalation": true,
    "NotifyEmailOnEscalation": true,
    "MaxConcurrentLlm": 3,
    "LlmBusyWaitSeconds": 6,
    "MaxSessionsPerIpPerHour": 15,
    "MaxMessagesPerIpPerMinute": 20,
    "MaxMessagesPerSession": 80,
    "TurnstileSiteKey": "",
    "TurnstileSecretKey": ""
  }
}
