<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <OutputType>Library</OutputType>
  </PropertyGroup>

  <ItemGroup>
    <Folder Include="Properties\" />
    <Folder Include="Queries\" />
    <Folder Include="Mappings\" />
    <Folder Include="Utills\" />
  </ItemGroup>

  <ItemGroup>
    <!-- Дефолтная обложка для карточек бота, когда у игры нет своей (принцип сайта: cover → fallback). -->
    <EmbeddedResource Include="Assets\game-cover-fallback.png" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Configuration.Abstractions" Version="10.0.12" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Binder" Version="10.0.12" />
    <PackageReference Include="Telegram.Bot" Version="22.10.3.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\SuperBot.Core\SuperBot.Core.csproj" />
  </ItemGroup>

</Project>
