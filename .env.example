# Copy this file to `.env` and fill in real values. `.env` is gitignored — never commit it.
# docker-compose reads these; the backend maps *_ env vars onto config via the __ separator.

# --- Public URLs ---
# Your real site URL in production, e.g. https://your-domain.com. Leave empty for local dev
# (defaults to http://localhost). Drives MainUrl, JWT issuer/audience, frontend URL, recovery
# links and the Telegram webhook.
PUBLIC_URL=
# Public URL of Keycloak as the browser sees it (e.g. https://your-domain.com/keycloak or
# https://auth.your-domain.com). Empty = http://localhost:8088 for local dev.
KEYCLOAK_PUBLIC_URL=

# --- Infrastructure (Mongo / Keycloak) ---
MONGO_ROOT_USER=
MONGO_ROOT_PASSWORD=
# Keycloak master-realm admin console (http://localhost:8088/admin). Default is admin for local dev.
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin
KEYCLOAK_DB=
KEYCLOAK_DB_USER=
KEYCLOAK_DB_PASSWORD=

# --- Keycloak confidential admin client (backend <-> Keycloak Admin API) ---
# Must match the "secret" of client `tale-shop-admin` in keycloak/import/TaleShop-realm.json.
KEYCLOAK_ADMIN_CLIENT_SECRET=change-me-strong-random

# --- Application secrets (backend) ---
# Telegram bot token from @BotFather. Rotate here after revoking a leaked one.
BOT_TOKEN=
# Secret for the Telegram webhook (X-Telegram-Bot-Api-Secret-Token). Any random string,
# e.g. `openssl rand -hex 24`. Empty = webhook accepts unsigned POSTs (local dev only).
BOT_WEBHOOK_SECRET=
# USD→Telegram Stars conversion rate for in-bot payments (demo rate). Empty = 50.
STARS_PER_USD=50

# --- Crypto payments DEMO (BTCPay Server, TESTNET ONLY) ---
# Leave all empty to disable the crypto option on checkout. This is a demo integration:
# point it at a TESTNET BTCPay instance (https://docs.btcpayserver.org/Docker/) — never mainnet.
# API key needs btcpay.store.cancreateinvoice + btcpay.store.canviewinvoices for your store.
# Webhook: BTCPay store → Webhooks → URL {PUBLIC_URL}/api/payments/crypto/webhook, set the same secret here.
BTCPAY_URL=
BTCPAY_API_KEY=
BTCPAY_STORE_ID=
BTCPAY_WEBHOOK_SECRET=
# JWT signing key — use a long random string, e.g. `openssl rand -base64 48`.
JWT_SECRET=
# Stripe API keys (test keys start with sk_test_ / pk_test_).
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# --- Cloudflare Turnstile (bot check on chat) — leave empty to disable ---
# Create a Turnstile widget at dash.cloudflare.com → Turnstile. Site key is public, secret is not.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- Demo catalog seed ---
# For a portfolio/demo deploy set SEED_ENABLED=true — the storefront is populated with a curated
# catalog (games, keys, discounts, self-hosted covers) on startup, idempotently. Leave empty/false
# for a real deploy so production stays clean. SEED_FORCE=true rebuilds the demo catalog on next start.
SEED_ENABLED=true
SEED_FORCE=false
