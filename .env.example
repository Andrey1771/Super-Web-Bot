# Copy this file to `.env` and fill in real values. `.env` is gitignored — never commit it.
# docker-compose reads these; the backend maps *_ env vars onto config via the __ separator.

# --- Public URLs ---
# Your real site URL in production, e.g. https://your-domain.com. Leave empty for local dev
# (defaults to http://localhost). Drives MainUrl, JWT issuer/audience, frontend URL, recovery
# links and the Telegram webhook.
PUBLIC_URL=

# Адрес вебхука Telegram, если он не совпадает с адресом сайта. Пусто — берётся PUBLIC_URL
# плюс /api/Telegram. Нужен для локальной разработки: Telegram принимает вебхук только по
# https, поэтому сайт на localhost выставляют наружу туннелем (ngrok, cloudflared), а его
# адрес пишут сюда — например https://abc123.ngrok-free.app/api/Telegram
BOT_WEBHOOK_URL=

# Public URL of Keycloak as the browser sees it (e.g. https://your-domain.com/keycloak or
# https://auth.your-domain.com). Empty = http://localhost:8088 for local dev.
KEYCLOAK_PUBLIC_URL=

# --- Infrastructure (Mongo / Keycloak) ---
MONGO_ROOT_USER=
MONGO_ROOT_PASSWORD=
# Keycloak master-realm admin console (http://localhost:8088/admin). Default is admin for local dev.
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin
KEYCLOAK_DB=
KEYCLOAK_DB_USER=
KEYCLOAK_DB_PASSWORD=

# --- Keycloak confidential admin client (backend <-> Keycloak Admin API) ---
# Must match the "secret" of client `tale-shop-admin` in keycloak/import/TaleShop-realm.json.
KEYCLOAK_ADMIN_CLIENT_SECRET=change-me-strong-random

# --- Application secrets (backend) ---
# Telegram bot token from @BotFather. Rotate here after revoking a leaked one.
# Без него сервис бота стартует, но раздел Bot в админке и вебхук не работают —
# в логе контейнера bot будет одна строка уровня Error с причиной.
BOT_TOKEN=
# Secret for the Telegram webhook (X-Telegram-Bot-Api-Secret-Token). Any random string,
# e.g. `openssl rand -hex 24`. Empty = webhook accepts unsigned POSTs (local dev only).
BOT_WEBHOOK_SECRET=
# USD→Telegram Stars conversion rate for in-bot payments (demo rate). Empty = 50.
STARS_PER_USD=50

# --- Crypto payments DEMO (BTCPay Server, TESTNET ONLY) ---
# Leave all empty to disable the crypto option on checkout. This is a demo integration:
# point it at a TESTNET BTCPay instance (https://docs.btcpayserver.org/Docker/) — never mainnet.
# API key needs btcpay.store.cancreateinvoice + btcpay.store.canviewinvoices for your store.
# Webhook: BTCPay store → Webhooks → URL {PUBLIC_URL}/api/payments/crypto/webhook, set the same secret here.
# Рельс выключен по умолчанию: интеграция осталась в коде, но магазин её не предлагает.
# Чтобы вернуть — BTCPAY_ENABLED=true и заполнить ключи ниже.
BTCPAY_ENABLED=false
BTCPAY_URL=
BTCPAY_API_KEY=
BTCPAY_STORE_ID=
BTCPAY_WEBHOOK_SECRET=
# --- Админ САЙТА (не админ-консоли Keycloak выше) ---
# Пользователь realm TaleShop, создаётся при импорте realm. Пусто = admin/admin.
# Значения подставляются в keycloak/import/TaleShop-realm.json вместо плейсхолдеров,
# поэтому применяются только при пересоздании контейнера keycloak:
#   docker compose up -d --force-recreate keycloak
TALESHOP_ADMIN_USER=
TALESHOP_ADMIN_PASSWORD=
TALESHOP_ADMIN_EMAIL=

# JWT signing key — use a long random string, e.g. `openssl rand -base64 48`.
JWT_SECRET=
# Stripe API keys (test keys start with sk_test_ / pk_test_).
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# --- Support chat AI ---
# Which model answers in the support chat: deepseek (external API, default) or ollama (local).
# Ollama stays the fallback either way: the chat switches to it on its own when the key is
# missing, the API is unreachable, or the daily budget is spent. Set to ollama to develop
# without spending money.
SUPPORT_CHAT_PROVIDER=deepseek

# Key and model from the provider dashboard. Without a key the chat silently runs on Ollama.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat

# Sent with every request as the OpenAI-compatible "user" field, so our apps are
# distinguishable in the provider logs when they share one key.
#
# Note: DeepSeek does NOT split billing by this field in the dashboard. If you need the spend
# of each app counted separately, issue a separate API key per app — that is the only split
# the provider actually reports.
SUPPORT_CHAT_APP_TAG=tale-shop-support

# Daily spend cap in USD for the external provider. 0 = no cap; when it is reached the chat
# falls back to Ollama until the next day.
SUPPORT_CHAT_DAILY_BUDGET_USD=0

# --- Live chat handoff ---
# Mailbox that receives the alert when the AI hands a chat to a human (category, reason,
# conversation summary, link to the session). Empty = the alert goes to the SMTP sender address.
SUPPORT_SPECIALIST_EMAIL=

# --- Приглашения оставить отзыв ---------------------------------------------------------
# Письмо «расскажите, как вам игра» уходит через REVIEW_INVITES_DELAY_DAYS дней после выдачи
# ключа, по одному на заказ, и только тем, кто не отказался от таких писем.
#
# По умолчанию ВЫКЛЮЧЕНО. Включать осознанно и лучше после того, как настроите SPF/DKIM:
# залп с нового домена уезжает в спам, и reputation потом восстанавливается месяцами.
# MAX_AGE_DAYS — верхняя граница возраста заказа. Она же страховка при первом включении:
# без неё первый запуск написал бы всем покупателям за всю историю магазина разом.
REVIEW_INVITES_ENABLED=false
REVIEW_INVITES_DELAY_DAYS=7
REVIEW_INVITES_MAX_AGE_DAYS=30

# Год основания магазина для страницы «О нас». Единственная цифра на ней, которую нельзя
# посчитать по базе. Пусто — плитку не показываем; выдумывать дату основания нельзя.
ABOUT_FOUNDED_YEAR=

# --- Куда бот пишет владельцу -----------------------------------------------------------
# Telegram-логин (без @) и chat id, куда уходят уведомления о заказах и эскалациях.
# Раньше лежали прямо в appsettings.json, то есть в репозитории и на GitHub — это личные
# идентификаторы, им там не место. Пусто — уведомления в Telegram просто не уходят.
TELEGRAM_ADMIN_USERNAME=
TELEGRAM_ADMIN_CHAT_ID=

# Как часто бэкенд перечитывает настройки сайта из базы, секунды. Нужно при нескольких
# репликах: правка в админке приходит на одну из них, остальные подхватывают её по этому
# сроку. 0 — читать при каждом обращении (только для тестов).
SITE_SETTINGS_REFRESH_SECONDS=30

# --- Cloudflare Turnstile (bot check on chat) — leave empty to disable ---
# Create a Turnstile widget at dash.cloudflare.com → Turnstile. Site key is public, secret is not.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- Google Analytics reports inside the admin panel (optional) ---
# NOT needed to collect data. The storefront sends everything to GA with the Measurement ID
# entered in Admin → Analytics → Settings. These three are the opposite direction: they let the
# server READ the reports back and draw them on the Analytics overview page.
#
# Where to get them (about 15 minutes, all in Google, nothing is entered in the admin panel):
#  1. console.cloud.google.com → create a project (any name).
#  2. Search for "Google Analytics Data API" → Enable.
#  3. APIs & Services → OAuth consent screen → External → fill in the name and your e-mail,
#     then add that same e-mail under Test users. On the same screen press "Publish app":
#     while the app stays in Testing, Google expires the refresh token after 7 days and the
#     reports quietly stop loading. Verification is not required for this.
#  4. APIs & Services → Credentials → Create credentials → OAuth client ID → Web application.
#     Add https://developers.google.com/oauthplayground as an authorised redirect URI.
#     Google shows the Client ID and Client Secret — the first two values below.
#  5. developers.google.com/oauthplayground → gear icon → "Use your own OAuth credentials" →
#     paste the ID and secret → in the list pick Google Analytics Data API v1 →
#     .../auth/analytics.readonly → Authorize APIs → sign in → Exchange authorization code
#     for tokens. The response contains refresh_token — the third value below.
#
# These can also be entered in Admin → Analytics → Settings → Report access, which needs no
# restart; a value saved there wins over the variable below.
#
# Leave empty until you need the charts in the panel; the reports are on the GA site anyway.
GA_OAUTH_CLIENT_ID=
GA_OAUTH_CLIENT_SECRET=
GA_OAUTH_REFRESH_TOKEN=

# Общий токен для служебных вызовов между backend и bot (фоновые проверки здоровья).
# Любая длинная случайная строка. Пустой — служебный вход закрыт, проверка вебхука в
# фоновом мониторе получит 401 и покажется как warn, а не как поломка.
INTERNAL_SERVICE_TOKEN=
